{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.2/schemas/edge.schema.json",
  "title": "AEPG Edge",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.edge/v0.2"
    },
    "edge_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "edge_type": {
      "enum": [
        "ASSOCIATED_WITH",
        "USED",
        "INVOKED",
        "GENERATED",
        "ACCESSED",
        "PRODUCED_EVENT",
        "AUTHORIZED",
        "USES_GRANT",
        "GOVERNED",
        "ENFORCED",
        "SENT",
        "RECEIVED",
        "SHARED",
        "RETRIEVED",
        "DERIVED_FROM",
        "REVOKED_BY"
      ]
    },
    "source_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "activity_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "observer_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "evidence_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "edge_id",
    "edge_type",
    "source_id",
    "target_id",
    "activity_id",
    "observed_at",
    "observer_id",
    "evidence_hash",
    "signature"
  ],
  "additionalProperties": false
}