{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.2/schemas/recovery.schema.json",
  "title": "Recovery",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.recovery/v0.2"
    },
    "recovery_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "trigger_revocation_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "affected_root_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "failed"
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "completed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "recovery_id",
    "trigger_revocation_id",
    "affected_root_ids",
    "actions",
    "status",
    "started_at",
    "completed_at",
    "evidence_refs",
    "signature"
  ],
  "additionalProperties": false
}