{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.3/schemas/authority-basis.schema.json",
  "title": "AuthorityBasis",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.authority-basis/v0.3"
    },
    "authority_basis_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "mode": {
      "$ref": "common.schema.json#/$defs/authorityMode"
    },
    "grant_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "authority_root_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "threshold": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "proof_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "revocation_snapshot_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "policy_version": {
      "type": "string"
    },
    "evaluated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "authority_basis_id",
    "mode",
    "grant_ids",
    "authority_root_ids",
    "threshold",
    "proof_hash",
    "revocation_snapshot_id",
    "policy_version",
    "evaluated_at",
    "signature"
  ],
  "additionalProperties": false
}