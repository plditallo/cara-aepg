{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.3/schemas/execution-acknowledgment.schema.json",
  "title": "ExecutionAcknowledgment",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.execution-acknowledgment/v0.3"
    },
    "ack_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "receipt_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "activity_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "outcome": {
      "enum": [
        "EXECUTED",
        "DENIED",
        "SAFE_STATE",
        "PARTIAL",
        "UNKNOWN"
      ]
    },
    "observed_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "observer_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "evidence_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "ack_id",
    "receipt_id",
    "activity_id",
    "outcome",
    "observed_at",
    "observer_id",
    "evidence_hash",
    "signature"
  ],
  "additionalProperties": false
}