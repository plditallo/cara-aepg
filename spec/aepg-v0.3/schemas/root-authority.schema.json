{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.3/schemas/root-authority.schema.json",
  "title": "RootAuthority",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.root-authority/v0.3"
    },
    "root_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issuer": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "objective_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "instruction_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "context_manifest_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "policy_version": {
      "type": "string"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "initial_grant_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "root_id",
    "issuer",
    "objective_hash",
    "instruction_hash",
    "context_manifest_hash",
    "policy_version",
    "created_at",
    "expires_at",
    "initial_grant_ids",
    "signature"
  ],
  "additionalProperties": false
}