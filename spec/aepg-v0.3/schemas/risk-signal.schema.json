{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.3/schemas/risk-signal.schema.json",
  "title": "RiskSignal",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.risk-signal/v0.3"
    },
    "risk_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "activity_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "risk_class": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_event_ids": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string"
    },
    "recommended_action": {
      "type": "string"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "risk_id",
    "subject_ids",
    "activity_ids",
    "risk_class",
    "severity",
    "confidence",
    "evidence_event_ids",
    "policy_version",
    "recommended_action",
    "created_at",
    "signature"
  ],
  "additionalProperties": false
}