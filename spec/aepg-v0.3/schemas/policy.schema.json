{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cara.example/spec/aepg/v0.3/schemas/policy.schema.json",
  "title": "Policy",
  "type": "object",
  "properties": {
    "schema": {
      "const": "cara.policy/v0.3"
    },
    "policy_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "policy_version": {
      "type": "string"
    },
    "content_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "status": {
      "enum": [
        "active",
        "retired",
        "suspended"
      ]
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  },
  "required": [
    "schema",
    "policy_id",
    "policy_version",
    "content_hash",
    "status",
    "issued_at",
    "signature"
  ],
  "additionalProperties": false
}